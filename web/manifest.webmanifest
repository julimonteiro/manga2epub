{
  "name": "Manga Kindle",
  "short_name": "Mangas",
  "description": "Your manga library, downloads and reading queue",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#111318",
  "theme_color": "#111318",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Read now", "url": "/?tab=now", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Library", "url": "/?tab=library", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Add manga", "url": "/?add=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
